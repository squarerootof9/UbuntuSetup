# ---- Python venv quick-tools (bash) ----

# python uses the currently activated venv's python
# operations outside a venv: always use python3

# Show active venv in prompt (clean + unobtrusive)
if [[ -n "${PS1-}" ]]; then
	_venv_ps1() {
		[[ -n "${VIRTUAL_ENV-}" ]] || return 0
		printf " (%s)" "$(basename "$VIRTUAL_ENV")"
	}
	# Adds " (.venvname)" near the end of your prompt if one is active
	#PS1="${PS1}\$(_venv_ps1)"
fi

# vnew [python_cmd] [venv_dir]
# Examples:
#   vnew                -> python3 -m venv .venv + upgrades pip/setuptools/wheel
#   vnew python3.12     -> make .venv using python3.12
#   vnew python3 .venv2 -> make .venv2 using python3
vnew() {
	local py="${1:-python3}"
	local dir="${2:-.venv}"

	if [[ -d "$dir" ]]; then
		echo "✓ venv exists: $dir"
	else
		"$py" -m venv "$dir" || {
			echo "✗ venv creation failed."
			echo "  On Ubuntu, you may need: sudo apt install python3-venv (or ${py}-venv)"
			return 1
		}
		echo "✓ created: $dir"
	fi

	# Activate + basic upgrades
	# shellcheck disable=SC1090
	source "$dir/bin/activate" || return 1
	python -m pip install -U pip setuptools wheel >/dev/null
	echo "✓ activated: $dir"
}

# von [venv_dir]  -> activate (default: .venv)
von() {
	local dir="${1:-.venv}"
	# shellcheck disable=SC1090
	[[ -f "$dir/bin/activate" ]] && source "$dir/bin/activate" && echo "✓ activated: $dir" ||
		{
			echo "✗ no venv at: $dir (use: vnew)"
			return 1
		}
}

# voff -> deactivate safely
voff() { type deactivate >/dev/null 2>&1 && deactivate && echo "✓ deactivated" || true; }

# vpip ... -> always use the right pip
vpip() { python -m pip "$@"; }

# vreq [file] -> install requirements (default: requirements.txt)
vreq() {
	local f="${1:-requirements.txt}"
	[[ -f "$f" ]] || {
		echo "✗ missing: $f"
		return 1
	}
	python -m pip install -r "$f"
}

# Optional: auto-activate .venv when you cd into a folder that has it
# Enable by uncommenting the line at the bottom.
_auto_venv() {
	# If already in a venv, do nothing unless you left its folder tree
	if [[ -n "${VIRTUAL_ENV-}" ]]; then
		# If cwd is no longer under the venv's parent, auto-deactivate
		local vparent
		vparent="$(dirname "$VIRTUAL_ENV")"
		[[ "$PWD" == "$vparent"* ]] || voff
		return 0
	fi

	# Auto-activate local .venv if present
	[[ -f ".venv/bin/activate" ]] && von .venv >/dev/null 2>&1
}
# PROMPT_COMMAND="_auto_venv${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# ---- venv/pip helpers ----

# Upgrade the core packaging toolchain in the *current* Python/venv
vset() {
	python -m pip install -U pip setuptools wheel
}

# Purge pip's download/build cache (user cache; affects all venvs for your user)
vcp() {
	python -m pip cache purge
}

# List installed packages (pass extra args if you want, e.g. --format=columns)
vlist() {
	python -m pip list "$@"
}

# Show outdated packages
vout() {
	python -m pip list --outdated
}

# Basic dependency health check (very handy when something feels "off")
vcheck() {
	python -m pip check
}

# Freeze current env to a requirements file (default: requirements.txt)
vfreeze() {
	local f="${1:-requirements.txt}"
	python -m pip freeze >"$f"
	echo "✓ wrote $f"
}

# Upgrade *all* outdated packages in the current env
vupall() {
	python -m pip list --outdated --format=freeze |
		cut -d= -f1 |
		xargs -r python -m pip install -U
}

# Quick “what am I using right now?”
venvinfo() {
	echo "python: $(command -v python)"
	python --version
	python -m pip --version
	[[ -n "${VIRTUAL_ENV-}" ]] && echo "venv:   $VIRTUAL_ENV" || echo "venv:   (none)"
}

vhelp() {
	cat <<'EOF'

Python / venv helpers
---------------------

venv
  vnew [python] [dir]   Create + activate venv (default: python3 .venv)
  von  [dir]            Activate venv (default: .venv)
  voff                  Deactivate current venv

pip (always targets the *current* python/venv)
  vset                  Upgrade pip + setuptools + wheel
  vlist [args...]        List installed packages (passes args to: pip list)
  vout                  Show outdated packages
  vcheck                Dependency sanity check (pip check)
  vreq  [file]           Install requirements (default: requirements.txt)
  vfreeze [file]         Write requirements (default: requirements.txt)
  vupall                Upgrade all outdated packages in this env
  vcp                   Purge pip cache (user-wide)
  venvinfo                 Show which python/pip/venv you're using

EOF
}

