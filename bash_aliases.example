EOF
}

mknpmnode() {

	# Basic sanity checks
	if ! command -v npm >/dev/null 2>&1; then
		echo "❌ npm not found."
		return 1
	fi

	#mkdir tommy-tester
	#cd tommy-tester
	#run from inside directory

	npm init -y
	npx hardhat --init
	npx hardhat compile
	npm i @openzeppelin/contracts
	npm i --save-dev hardhat @nomicfoundation/hardhat-toolbox @openzeppelin/contracts --force
	npm install @inquirer/prompts --force
	npm install --save-dev @nomicfoundation/hardhat-ledger
	npm install hardhat-gas-reporter --save-dev --force

	curl -L https://foundry.paradigm.xyz | bash
	foundryup
	forge --version
	forge init --force
	forge install foundry-rs/forge-std

	# add y/n to launch (and serve as a pause to change config)
	npx hardhat node --network localNode

}

vup() {
	local log="/tmp/hideme-free-nl.log"

	# Ask for sudo password in the foreground, where it can actually prompt.
	sudo -v || return 1

	# Avoid double-start.
	if ip link show vpn >/dev/null 2>&1; then
		echo "✓ VPN already up"
		return 0
	fi

	(
		cd /opt/hide.me || exit 1

		sudo -n setsid ./hide.me \
			-d 1.1.1.1:53,8.8.8.8:53 \
			connect free-nl \
			>"$log" 2>&1 </dev/null &
	)

	sleep 3

	if ip link show vpn >/dev/null 2>&1; then
		echo "✓ VPN up"
		sudo wg show 2>/dev/null || true
	else
		echo "✗ VPN did not come up yet. Log:"
		tail -n 40 "$log"
		return 1
	fi
}

vdown() {
	sudo -v || return 1

	(
		cd /opt/hide.me || exit 1
		sudo -n ./hide.me disconnect 2>/dev/null || true
	)

	sleep 2

	sudo ip link delete vpn 2>/dev/null || true

	while ip rule show | grep -q 'lookup 55555'; do
		sudo ip rule del table 55555 2>/dev/null || break
	done

	while ip -6 rule show | grep -q 'lookup 55555'; do
		sudo ip -6 rule del table 55555 2>/dev/null || break
	done

	sudo ip route flush table 55555 2>/dev/null || true
	sudo ip -6 route flush table 55555 2>/dev/null || true

	echo "✓ VPN down / routes cleaned"
}

vpnsetup() {
	local startdir
	local dl_dir="$HOME/Downloads"
	local archive="hide.me-linux-amd64.tar.gz"
	local url="https://hide.me/download/linux-amd64"
	local workdir="$dl_dir/hide.me-linux"

	startdir="$(pwd)"

	sudo -v || return 1

	mkdir -p "$dl_dir"

	cd "$dl_dir" || return 1

	echo "➜ Downloading hide.me Linux client..."
	wget -O "$archive" "$url" || {
		cd "$startdir" || true
		return 1
	}

	echo "➜ Extracting..."
	rm -rf "$workdir"
	mkdir -p "$workdir"

	tar -xzf "$archive" -C "$workdir" || {
		cd "$startdir" || true
		return 1
	}

	cd "$workdir" || {
		cd "$startdir" || true
		return 1
	}

	echo "➜ Contents:"
	ls -la

	echo "➜ Running installer..."
	sudo ./install.sh || {
		cd "$startdir" || true
		return 1
	}

	echo "➜ Disabling packaged hide.me services for manual mode..."
	sudo systemctl disable --now 'hide.me@nl.service' 2>/dev/null || true
	sudo systemctl disable --now 'hide.me@free-nl.service' 2>/dev/null || true
	sudo systemctl disable --now 'hide.me@us.service' 2>/dev/null || true
	sudo systemctl disable --now 'hide.me@free-us.service' 2>/dev/null || true

	cd "$startdir" || true

	echo "✓ hide.me installed."
	echo "  Use: vup"
	echo "  Use: vdown"
}
